@inherits LayoutComponentBase
@using LTSFrontend.Core.Auth
@using LTSFrontend.Features.Auth.Services
@using LTSFrontend.Shared.Components
@using LTSFrontend.State
@using Microsoft.AspNetCore.Components.Authorization
@inject UserSessionState Session
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="lts-app-shell @(_sidebarCollapsed ? "sidebar-collapsed" : "") @(_mobileNavOpen ? "mobile-nav-open" : "")">
    <div class="lts-sidebar-backdrop" @onclick="CloseMobileNav"></div>

    <div class="lts-sidebar">
        <div class="brand">
            <i class="bi bi-shield-check fs-4"></i>
            <span class="brand-text">LTS</span>
        </div>
        <NavMenu />
    </div>

    <div class="lts-main-content">
        <div class="lts-topbar">
            <div class="lts-topbar-left">
                <button class="lts-icon-btn d-lg-none" title="Menu" @onclick="ToggleMobileNav">
                    <i class="bi bi-list"></i>
                </button>
                <button class="lts-icon-btn d-none d-lg-inline-flex" title="Collapse sidebar" @onclick="ToggleSidebar">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
                <div class="fw-semibold">Litigation Tracking System</div>
            </div>
            <div class="lts-topbar-right">
                <button class="lts-icon-btn" title="Toggle theme" @onclick="ToggleThemeAsync">
                    <i class="bi @(_isDarkTheme ? "bi-sun" : "bi-moon-stars")"></i>
                </button>
                <button class="lts-icon-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </button>
                <div class="dropdown">
                    <button class="lts-user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <span class="lts-avatar">@Initials</span>
                        <span class="d-none d-md-inline">@(string.IsNullOrWhiteSpace(Session.FullName) ? "User" : Session.FullName)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end lts-dropdown-menu">
                        <li><a class="dropdown-item" href="/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><button class="dropdown-item text-danger" @onclick="HandleLogoutAsync"><i class="bi bi-box-arrow-right me-2"></i>Logout</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="lts-content-body">
            @Body
        </div>
    </div>
</div>

<ToastNotification />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _mobileNavOpen;
    private bool _isDarkTheme;

    private string Initials =>
        string.IsNullOrWhiteSpace(Session.FullName)
            ? "U"
            : string.Concat(Session.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("ltsTheme.get");
                _isDarkTheme = theme == "dark";
                StateHasChanged();
            }
            catch
            {
                // JS interop not ready yet (prerender) - default to light theme.
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkTheme = !_isDarkTheme;
        await JS.InvokeVoidAsync("ltsTheme.set", _isDarkTheme ? "dark" : "light");
    }

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    private void ToggleMobileNav() => _mobileNavOpen = !_mobileNavOpen;

    private void CloseMobileNav() => _mobileNavOpen = false;

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();

        var provider = (CustomAuthStateProvider)AuthStateProvider;
        await provider.MarkUserAsLoggedOutAsync();

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
