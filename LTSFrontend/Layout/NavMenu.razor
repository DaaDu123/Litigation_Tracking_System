@using LTSFrontend.State
@inject UserSessionState Session

<nav>
    <div class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2"></i> <span class="nav-label">Dashboard</span>
        </NavLink>
    </div>

    @* ===================================================================
       FIRM-OPERATIONAL AREA - every role except SuperAdmin. SuperAdmin is
       a platform-level role (Firms + system Audit Logs only) and must not
       see case/hearing/deadline/user/master-data screens - see
       RoleNames.cs and DocumentPermissionService for the backend side of
       this same policy.
       =================================================================== *@
    <AuthorizeView Roles="FirmAdmin,Partner,AssociateLawyer,Moharrir,InternParalegal">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="cases">
                    <i class="bi bi-briefcase"></i> <span class="nav-label">Cases</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="cases/my-assigned">
                    <i class="bi bi-person-check"></i> <span class="nav-label">My Assigned Cases</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="hearings">
                    <i class="bi bi-calendar-event"></i> <span class="nav-label">Hearings</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="deadlines">
                    <i class="bi bi-hourglass-split"></i> <span class="nav-label">Deadlines</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    @* Firm staff directory - FirmAdmin and Partner only (matches
       RoleNames.PartnerAndAbove / FirmAdminAndAbove on UsersController,
       both of which now exclude SuperAdmin). *@
    <AuthorizeView Roles="FirmAdmin,Partner">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="users">
                    <i class="bi bi-people"></i> <span class="nav-label">Users</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    @* Full Login History - only FirmAdmin holds ViewLoginHistory (see
       AppDbContext.SeedRolePermissions). Everyone still gets "My Login
       History" further down for their own account. *@
    <AuthorizeView Roles="FirmAdmin">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="login-history">
                    <i class="bi bi-clock-history"></i> <span class="nav-label">Login History</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    @* ===================================================================
       SUPERADMIN AREA - platform-level only: Firm workspace provisioning
       and system-wide Audit Logs. Nothing else. Roles & Permissions stays
       here too (RolesController/PermissionsController are deliberately
       SuperAdmin-only - see the design note on RolesController: Role and
       RolePermission are GLOBAL, non-tenant-scoped tables, so this is a
       pre-existing architectural constraint, not scope creep).
       =================================================================== *@
    <AuthorizeView Roles="SuperAdmin">
        <Authorized>
            <div class="nav-item">
                <NavLink class="nav-link" href="firms">
                    <i class="bi bi-building"></i> <span class="nav-label">Firm Workspaces</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="audit-logs">
                    <i class="bi bi-journal-check"></i> <span class="nav-label">Audit Logs</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    @* Master Data configuration - firm roles only, not SuperAdmin (managing
       a firm's own reference data is firm-internal, not a platform task). *@
    <AuthorizeView Roles="FirmAdmin,Partner,AssociateLawyer,Moharrir,InternParalegal">
        <Authorized>
            <div class="nav-section-title">Configuration</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="masters" Match="NavLinkMatch.All">
                    <i class="bi bi-diagram-3"></i> <span class="nav-label">Master Data</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/courts">
                    <i class="bi bi-bank"></i> <span class="nav-label">Courts</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-categories">
                    <i class="bi bi-diagram-2"></i> <span class="nav-label">Case Categories</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-stages">
                    <i class="bi bi-signpost-split"></i> <span class="nav-label">Case Stages</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/case-statuses">
                    <i class="bi bi-flag"></i> <span class="nav-label">Case Statuses</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/departments">
                    <i class="bi bi-diagram-3"></i> <span class="nav-label">Departments</span>
                </NavLink>
            </div>
            <div class="nav-item nav-item-sub">
                <NavLink class="nav-link" href="masters/document-types">
                    <i class="bi bi-file-earmark-text"></i> <span class="nav-label">Document Types</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="nav-item">
        <NavLink class="nav-link" href="profile">
            <i class="bi bi-person-circle"></i> <span class="nav-label">My Profile</span>
        </NavLink>
    </div>
    <div class="nav-item">
        <NavLink class="nav-link" href="login-history/my">
            <i class="bi bi-clock-history"></i> <span class="nav-label">My Login History</span>
        </NavLink>
    </div>
</nav>

