@page "/pricing"
@layout LTSFrontend.Layout.PublicPageLayout

<PageTitle>Pricing - Litigation Tracking System</PageTitle>

<section class="public-page-hero">
    <span class="eyebrow">Simple, Firm-Sized Pricing</span>
    <h1>Plans That Grow With Your Firm</h1>
    <p>
        Every plan includes secure multi-tenant workspaces, role-based access control,
        and full audit logging. Contact us for a tailored quote for your firm size.
    </p>
</section>

<section class="public-page-body">

    <div class="public-pricing-grid">
        <div class="public-pricing-card">
            <h3>Starter</h3>
            <p class="plan-desc">For solo practitioners &amp; small firms</p>
            <div class="price">Contact Us</div>
            <ul>
                <li><i class="bi bi-check-circle-fill"></i> Up to 5 users</li>
                <li><i class="bi bi-check-circle-fill"></i> Case &amp; hearing management</li>
                <li><i class="bi bi-check-circle-fill"></i> Document repository</li>
                <li><i class="bi bi-check-circle-fill"></i> Email notifications</li>
                <li><i class="bi bi-check-circle-fill"></i> Standard audit trail</li>
            </ul>
            <a href="/contact" class="btn-plan">Talk to Sales</a>
        </div>

        <div class="public-pricing-card featured">
            <span class="badge-featured">Most Popular</span>
            <h3>Professional</h3>
            <p class="plan-desc">For growing law firms &amp; legal departments</p>
            <div class="price">Contact Us</div>
            <ul>
                <li><i class="bi bi-check-circle-fill"></i> Up to 50 users</li>
                <li><i class="bi bi-check-circle-fill"></i> Full role-based access control</li>
                <li><i class="bi bi-check-circle-fill"></i> Reports &amp; management dashboards</li>
                <li><i class="bi bi-check-circle-fill"></i> Deadline &amp; hearing reminders</li>
                <li><i class="bi bi-check-circle-fill"></i> Full audit trail &amp; login history</li>
            </ul>
            <a href="/contact" class="btn-plan">Get Started</a>
        </div>

        <div class="public-pricing-card">
            <h3>Enterprise</h3>
            <p class="plan-desc">For multi-office firms &amp; legal departments</p>
            <div class="price">Contact Us</div>
            <ul>
                <li><i class="bi bi-check-circle-fill"></i> Unlimited users</li>
                <li><i class="bi bi-check-circle-fill"></i> Multi-firm / multi-tenant workspaces</li>
                <li><i class="bi bi-check-circle-fill"></i> Dedicated onboarding &amp; support</li>
                <li><i class="bi bi-check-circle-fill"></i> Data export &amp; migration support</li>
                <li><i class="bi bi-check-circle-fill"></i> Priority 24/7 support</li>
            </ul>
            <a href="/contact" class="btn-plan">Contact Sales</a>
        </div>
    </div>

    <div class="public-cta-banner">
        <h2>Not Sure Which Plan Fits?</h2>
        <p>Call us at +92 316 0928247 or send a message and we'll help you choose.</p>
        <a href="/contact" class="btn-gold">Contact Us</a>
    </div>

</section>
