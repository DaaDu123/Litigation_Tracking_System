@page "/benefits"
@layout LTSFrontend.Layout.PublicPageLayout

<PageTitle>Benefits - Litigation Tracking System</PageTitle>

<section class="public-page-hero">
    <span class="eyebrow">Why Litigation Tracking System</span>
    <h1>Less Risk. Less Manual Work. More Control.</h1>
    <p>
        Replace scattered spreadsheets, paper diaries, and disconnected folders with one
        platform your whole firm can trust &mdash; built specifically for the way litigation
        actually gets managed.
    </p>
</section>

<section class="public-page-body">

    <div class="public-stat-grid">
        <div class="public-stat-card">
            <div class="stat-number">99.5%</div>
            <div class="stat-label">Target System Uptime</div>
        </div>
        <div class="public-stat-card">
            <div class="stat-number">&lt;3s</div>
            <div class="stat-label">Search Response Time</div>
        </div>
        <div class="public-stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Actions Audit-Logged</div>
        </div>
        <div class="public-stat-card">
            <div class="stat-number">1000+</div>
            <div class="stat-label">Concurrent Users Supported</div>
        </div>
    </div>

    <div class="public-split-row">
        <div>
            <div class="public-section-title" style="text-align:left; margin:0 0 1.5rem;">
                <span class="eyebrow">For Legal Teams</span>
                <h2>Never Miss a Hearing or Deadline Again</h2>
            </div>
            <ul class="public-check-list">
                <li>
                    <i class="bi bi-check-lg"></i>
                    <div>
                        <h4>Automated Reminders</h4>
                        <p>Hearing and deadline alerts are generated automatically and sent to the right people &mdash; no manual follow-ups.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check-lg"></i>
                    <div>
                        <h4>One Central Repository</h4>
                        <p>Every case file, document, and note lives in one searchable place instead of scattered folders and inboxes.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check-lg"></i>
                    <div>
                        <h4>Real-Time Visibility</h4>
                        <p>Partners and management see live case status, workload, and financial exposure without chasing updates.</p>
                    </div>
                </li>
                <li>
                    <i class="bi bi-check-lg"></i>
                    <div>
                        <h4>Faster Coordination</h4>
                        <p>Legal officers, lawyers, and external counsel stay aligned through shared assignments and notifications.</p>
                    </div>
                </li>
            </ul>
        </div>
        <div class="public-panel">
            <div class="public-contact-card" style="border:none; background:transparent; padding:0.75rem 0;">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <h4>The Old Way</h4>
                    <p>Missed hearings, lost paperwork, no visibility into case status, and hours spent on manual follow-ups.</p>
                </div>
            </div>
            <div class="public-contact-card" style="border:none; background:transparent; padding:0.75rem 0;">
                <i class="bi bi-check-circle"></i>
                <div>
                    <h4>The LTS Way</h4>
                    <p>Automated alerts, centralized records, and complete audit trails &mdash; so nothing falls through the cracks.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="public-section-title">
        <span class="eyebrow">Who Benefits</span>
        <h2>Built for Every Role in the Firm</h2>
        <p>Each role gets exactly the tools and visibility it needs &mdash; nothing more, nothing less.</p>
    </div>

    <div class="public-feature-grid">
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-person-badge"></i></div>
            <h3>Firm Admins &amp; Partners</h3>
            <p>Full oversight of the firm's litigation portfolio, workload, and analytics &mdash; without spreadsheets.</p>
        </div>
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-briefcase"></i></div>
            <h3>Associates &amp; Lawyers</h3>
            <p>A clear work queue of assigned cases, upcoming hearings, and pending deadlines.</p>
        </div>
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-journal-check"></i></div>
            <h3>Moharrir &amp; Clerks</h3>
            <p>Fast, structured data entry for cause lists, hearing dates, and document uploads.</p>
        </div>
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-mortarboard"></i></div>
            <h3>Interns &amp; Paralegals</h3>
            <p>Read-only or draft-only access so juniors can help without compliance risk.</p>
        </div>
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-graph-up-arrow"></i></div>
            <h3>Management</h3>
            <p>Executive KPIs on high-risk cases, financial exposure, and litigation trends.</p>
        </div>
        <div class="public-feature-card">
            <div class="icon-wrap"><i class="bi bi-building-check"></i></div>
            <h3>External Counsel</h3>
            <p>Secure, scoped access to assigned cases and documents &mdash; nothing else.</p>
        </div>
    </div>

    <div class="public-cta-banner">
        <h2>Ready to See the Difference?</h2>
        <p>Get in touch and we'll walk you through how LTS fits your firm's workflow.</p>
        <a href="/contact" class="btn-gold">Contact Us</a>
    </div>

</section>
