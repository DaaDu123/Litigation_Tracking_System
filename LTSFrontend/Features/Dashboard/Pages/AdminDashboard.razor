@page "/dashboard/admin"
@*TEMP-DISABLED-FOR-TESTING: @attribute [Authorize(Roles = "SuperAdmin")] *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Dashboard.Components
@using LTSFrontend.Features.Dashboard.Models
@using LTSFrontend.Features.Dashboard.Services
@using LTSFrontend.State
@inject IDashboardService DashboardService
@inject UserSessionState Session

<PageTitle>Admin Dashboard - LTS</PageTitle>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">Admin Dashboard</h1>
        <p class="lts-page-subtitle">Welcome back, @Session.FullName. Here's a platform-wide snapshot.</p>
    </div>
</div>

@if (_hasError)
{
    <div class="lts-state is-error">
        <div class="lts-state-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="lts-state-title">Couldn't load dashboard data</div>
        <div class="lts-state-desc">@_errorMessage</div>
        <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise"></i> Try Again
        </button>
    </div>
}
else
{
    @*
        SuperAdmin is the platform owner, not a firm's day-to-day admin - this
        dashboard is deliberately scoped to workspace/firm custody and
        system-wide audit visibility only. No case, document, or firm-user
        data appears here (that's the FirmAdmin/Partner dashboard at
        /dashboard/management) - see FirmDashboardDTO / SuperAdminDashboardDTO.
    *@
    <div class="lts-stat-grid">
        <KpiCard Title="Total Firms" Value="@_stats?.TotalFirms.ToString()" Icon="bi-building" Accent="#1b4fd6" IsLoading="_isLoading" Href="/firms" />
        <KpiCard Title="Active Firms" Value="@_stats?.ActiveFirms.ToString()" Icon="bi-building-check" Accent="#16a34a" IsLoading="_isLoading" Href="/firms" />
        <KpiCard Title="Blocked Firms" Value="@_stats?.BlockedFirms.ToString()" Icon="bi-building-slash" Accent="#dc2626" IsLoading="_isLoading" Href="/firms" />
        <KpiCard Title="Pending Domain Migrations" Value="@_stats?.PendingDomainMigrations.ToString()" Icon="bi-globe" Accent="#7c3aed" IsLoading="_isLoading" Href="/firms" />
        <KpiCard Title="Firm Admins" Value="@_stats?.TotalFirmAdmins.ToString()" Icon="bi-person-badge" Accent="#d97706" IsLoading="_isLoading" />
        <KpiCard Title="System Audit Log Entries" Value="@_stats?.TotalSystemAuditLogs.ToString()" Icon="bi-journal-text" Accent="#0891b2" IsLoading="_isLoading" Href="/audit-logs" />
        <KpiCard Title="Active Sessions" Value="@_stats?.TotalActiveSessions.ToString()" Icon="bi-clock-history" Accent="#0f766e" IsLoading="_isLoading" SubLabel="Non-expired login sessions, all firms" />
    </div>

    <div class="lts-dashboard-grid">
        <RecentActivityPanel Title="Recent System Activity" Items="_activityItems" IsLoading="_isLoading" EmptyMessage="No activity recorded yet." />

        <div class="lts-card">
            <div class="lts-chart-widget-title">Quick Links</div>
            <div class="lts-quicklink-grid">
                <a class="lts-quicklink" href="/firms"><i class="bi bi-building"></i> Firms</a>
                <a class="lts-quicklink" href="/audit-logs"><i class="bi bi-journal-text"></i> Audit Logs</a>
                <a class="lts-quicklink" href="/login-history"><i class="bi bi-clock-history"></i> Login History</a>
                <a class="lts-quicklink" href="/profile"><i class="bi bi-person-circle"></i> My Profile</a>
            </div>
        </div>
    </div>
}

@code {
    private SuperAdminDashboardDTO? _stats;
    private List<ActivityItem> _activityItems = new();
    private bool _isLoading = true;
    private bool _hasError;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        try
        {
            _stats = await DashboardService.GetSuperAdminStatsAsync();
            _activityItems = (_stats?.RecentActivities ?? new())
                .Select(a => new ActivityItem
                {
                    Title = string.IsNullOrWhiteSpace(a.Action) ? "System activity" : a.Action!,
                    Subtitle = a.UserID.HasValue ? $"By user #{a.UserID}" : "System",
                    Timestamp = a.Timestamp,
                    Icon = "bi-journal-text"
                })
                .ToList();
        }
        catch (ApiException ex)
        {
            _hasError = true;
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Dashboard data could not be loaded. Please check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
