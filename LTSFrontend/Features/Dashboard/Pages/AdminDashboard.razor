@page "/dashboard/admin"
@*TEMP-DISABLED-FOR-TESTING: @attribute [Authorize(Roles = "SuperAdmin")] *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Dashboard.Components
@using LTSFrontend.Features.Dashboard.Models
@using LTSFrontend.Features.Dashboard.Services
@using LTSFrontend.State
@using Microsoft.AspNetCore.Authorization
@inject IDashboardService DashboardService
@inject UserSessionState Session

<PageTitle>Admin Dashboard - LTS</PageTitle>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">Admin Dashboard</h1>
        <p class="lts-page-subtitle">Welcome back, @Session.FullName. Here's a system-wide snapshot.</p>
    </div>
</div>

@if (_hasError)
{
    <div class="lts-state is-error">
        <div class="lts-state-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="lts-state-title">Couldn't load dashboard data</div>
        <div class="lts-state-desc">@_errorMessage</div>
        <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise"></i> Try Again
        </button>
    </div>
}
else
{
    <div class="lts-stat-grid">
        <KpiCard Title="Total Users" Value="@_stats?.TotalUsers.ToString()" Icon="bi-people" Accent="#1b4fd6" IsLoading="_isLoading" Href="/users" />
        <KpiCard Title="Active Users" Value="@_stats?.ActiveUsers.ToString()" Icon="bi-person-check" Accent="#16a34a" IsLoading="_isLoading" Href="/users" />
        <KpiCard Title="Roles" Value="@_stats?.TotalRoles.ToString()" Icon="bi-shield-lock" Accent="#7c3aed" IsLoading="_isLoading" Href="/roles" />
        <KpiCard Title="Permissions" Value="@_stats?.TotalPermissions.ToString()" Icon="bi-key" Accent="#d97706" IsLoading="_isLoading" Href="/permissions/matrix" />
        <KpiCard Title="Audit Log Entries" Value="@_stats?.TotalAuditLogs.ToString()" Icon="bi-journal-text" Accent="#0891b2" IsLoading="_isLoading" />
        <KpiCard Title="Active Sessions" Value="@_stats?.TotalRefreshTokens.ToString()" Icon="bi-clock-history" Accent="#dc2626" IsLoading="_isLoading" SubLabel="Non-expired login sessions" />
    </div>

    <div class="lts-dashboard-grid">
        <RecentActivityPanel Title="Recent System Activity" Items="_activityItems" IsLoading="_isLoading" EmptyMessage="No activity recorded yet." />

        <div class="lts-card">
            <div class="lts-chart-widget-title">Quick Links</div>
            <div class="lts-quicklink-grid">
                <a class="lts-quicklink" href="/users"><i class="bi bi-people"></i> Users</a>
                <a class="lts-quicklink" href="/roles"><i class="bi bi-shield-lock"></i> Roles</a>
                <a class="lts-quicklink" href="/permissions/assign"><i class="bi bi-pencil-square"></i> Assign Permissions</a>
                <a class="lts-quicklink" href="/masters"><i class="bi bi-diagram-3"></i> Master Data</a>
                <a class="lts-quicklink" href="/cases"><i class="bi bi-briefcase"></i> Cases</a>
                <a class="lts-quicklink" href="/profile"><i class="bi bi-person-circle"></i> My Profile</a>
            </div>
        </div>
    </div>
}

@code {
    private DashboardDTO? _stats;
    private List<ActivityItem> _activityItems = new();
    private bool _isLoading = true;
    private bool _hasError;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        try
        {
            _stats = await DashboardService.GetStatsAsync();
            _activityItems = (_stats?.RecentActivities ?? new())
                .Select(a => new ActivityItem
                {
                    Title = string.IsNullOrWhiteSpace(a.Action) ? "System activity" : a.Action!,
                    Subtitle = a.UserID.HasValue ? $"By user #{a.UserID}" : "System",
                    Timestamp = a.Timestamp,
                    Icon = "bi-journal-text"
                })
                .ToList();
        }
        catch (ApiException ex)
        {
            _hasError = true;
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Dashboard data could not be loaded. Please check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
