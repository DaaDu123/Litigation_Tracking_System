@* Reusable recent-activity/list widget. Works for audit-log style activity (Admin/Management
   dashboards) as well as "recently updated cases" style lists (Lawyer/LegalOfficer/etc).
   Usage:
     <RecentActivityPanel Title="Recent Activity" Items="_activities" IsLoading="_isLoading" /> *@
@using LTSFrontend.Features.Dashboard.Models

<div class="lts-card">
    <div class="lts-chart-widget-title">@Title</div>

    @if (IsLoading)
    {
        <div class="lts-activity-list">
            @for (var i = 0; i < 5; i++)
            {
                <div class="lts-activity-item">
                    <div class="lts-skeleton" style="width:2.1rem; height:2.1rem; border-radius:50%; flex:0 0 auto;"></div>
                    <div style="flex:1;">
                        <div class="lts-skeleton lts-skeleton-text" style="width:60%;"></div>
                        <div class="lts-skeleton lts-skeleton-text" style="width:40%; margin-top:.35rem;"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Items.Count == 0)
    {
        <div class="lts-form-hint" style="margin-top:0;">@EmptyMessage</div>
    }
    else
    {
        <div class="lts-activity-list">
            @foreach (var item in Items)
            {
                @if (!string.IsNullOrWhiteSpace(item.Href))
                {
                    <a class="lts-activity-item" href="@item.Href">@ItemBody(item)</a>
                }
                else
                {
                    <div class="lts-activity-item">@ItemBody(item)</div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public List<ActivityItem> Items { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Nothing to show yet.";

    private RenderFragment ItemBody(ActivityItem item) => @<text>
        <div class="lts-activity-icon"><i class="bi @(string.IsNullOrWhiteSpace(item.Icon) ? "bi-dot" : item.Icon)"></i></div>
        <div style="flex:1; min-width:0;">
            <div class="lts-activity-title">@item.Title</div>
            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
            {
                <div class="lts-activity-subtitle">@item.Subtitle</div>
            }
        </div>
        @if (item.Timestamp.HasValue)
        {
            <div class="lts-activity-time">@FormatRelative(item.Timestamp.Value)</div>
        }
    </text>;

    private static string FormatRelative(DateTime timestamp)
    {
        var span = DateTime.UtcNow - timestamp.ToUniversalTime();
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return timestamp.ToLocalTime().ToString("dd MMM yyyy");
    }
}
