@* Modal for adding/editing a case party (plaintiff/defendant/etc).
   Usage:
     <CasePartyModal @ref="_partyModal" OnSaved="HandleSavedAsync" />
     _partyModal.OpenForCreate(caseId);
     _partyModal.OpenForEdit(party); *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.CaseParties.Models
@using LTSFrontend.Features.CaseParties.Services
@inject ICasePartyService PartyService

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="CloseIfNotSaving"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        <div class="lts-modal-header">
            <div class="lts-modal-icon lts-modal-icon-primary">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <h5 class="lts-modal-title">@(_isEdit ? "Edit Party" : "Add Case Party")</h5>
            </div>
        </div>

        <div class="lts-modal-body">
            @if (!string.IsNullOrWhiteSpace(_apiError))
            {
                <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm);">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@_apiError</span>
                </div>
            }

            <div class="row">
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Party Type <span class="required">*</span></label>
                    <select class="lts-form-control" @bind="_form.PartyType" disabled="@_isSaving">
                        @foreach (var t in CasePartyFormDTO.PartyTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Party Name <span class="required">*</span></label>
                    <input class="lts-form-control" @bind="_form.PartyName" disabled="@_isSaving" placeholder="Full name" />
                    @if (_showValidation && string.IsNullOrWhiteSpace(_form.PartyName))
                    {
                        <div class="lts-form-error">Party name is required.</div>
                    }
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Organization / Department</label>
                    <input class="lts-form-control" @bind="_form.Organization" disabled="@_isSaving" />
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Lawyer Name</label>
                    <input class="lts-form-control" @bind="_form.LawyerName" disabled="@_isSaving" />
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">CNIC</label>
                    <input class="lts-form-control" @bind="_form.CNIC" disabled="@_isSaving" />
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">NTN</label>
                    <input class="lts-form-control" @bind="_form.NTN" disabled="@_isSaving" />
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Contact No.</label>
                    <input class="lts-form-control" @bind="_form.ContactNo" disabled="@_isSaving" />
                </div>
                <div class="col-md-6 lts-form-group">
                    <label class="lts-form-label">Email</label>
                    <input class="lts-form-control" @bind="_form.Email" disabled="@_isSaving" />
                </div>
                <div class="col-12 lts-form-group">
                    <label class="lts-form-label">Address</label>
                    <textarea class="lts-form-control" rows="2" @bind="_form.Address" disabled="@_isSaving"></textarea>
                </div>
                <div class="col-12 lts-form-group">
                    <label class="lts-form-label">Remarks</label>
                    <textarea class="lts-form-control" rows="2" @bind="_form.Remarks" disabled="@_isSaving"></textarea>
                </div>
            </div>
        </div>

        <div class="lts-modal-footer">
            <button type="button" class="lts-btn lts-btn-ghost" @onclick="CloseIfNotSaving" disabled="@_isSaving">Cancel</button>
            <button type="button" class="lts-btn lts-btn-primary" @onclick="HandleSubmitAsync" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="lts-spinner lts-spinner-sm"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>
                    <span>@(_isEdit ? "Save Changes" : "Add Party")</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _isOpen;
    private bool _isEdit;
    private bool _isSaving;
    private bool _showValidation;
    private string? _apiError;

    private CasePartyFormDTO _form = new();

    public void OpenForCreate(long caseId)
    {
        _isEdit = false;
        _form = new CasePartyFormDTO { CaseID = caseId };
        ResetAndOpen();
    }

    public void OpenForEdit(CasePartyDTO party)
    {
        _isEdit = true;
        _form = new CasePartyFormDTO
        {
            PartyID = party.PartyID,
            CaseID = party.CaseID,
            PartyType = party.PartyType,
            PartyName = party.PartyName,
            Organization = party.Organization,
            CNIC = party.CNIC,
            NTN = party.NTN,
            ContactNo = party.ContactNo,
            Email = party.Email,
            Address = party.Address,
            LawyerName = party.LawyerName,
            Remarks = party.Remarks
        };
        ResetAndOpen();
    }

    private void ResetAndOpen()
    {
        _apiError = null;
        _showValidation = false;
        _isOpen = true;
        StateHasChanged();
    }

    private void CloseIfNotSaving()
    {
        if (_isSaving) return;
        _isOpen = false;
        StateHasChanged();
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.PartyName))
        {
            _showValidation = true;
            return;
        }

        _isSaving = true;
        _apiError = null;
        try
        {
            if (_isEdit)
                await PartyService.UpdateAsync(_form);
            else
                await PartyService.CreateAsync(_form);

            _isOpen = false;
            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _apiError = "Something went wrong while saving the party. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
