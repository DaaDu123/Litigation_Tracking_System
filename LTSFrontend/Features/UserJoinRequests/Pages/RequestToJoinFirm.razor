@page "/request-to-join"
@layout LTSFrontend.Layout.LoginLayout
@using LTSFrontend.Core.Enums
@using LTSFrontend.Features.UserJoinRequests.DTOs
@using LTSFrontend.Features.UserJoinRequests.Services
@inject IUserJoinRequestService UserJoinRequestService
@inject NavigationManager Navigation

<PageTitle>Request to Join a Firm - LTS</PageTitle>

@if (_submitted)
{
    <h2>Request Submitted</h2>
    <p class="auth-subtitle">Thank you, @_submittedName.</p>

    <div class="alert alert-success py-2">
        Your request to join <strong>@_submittedFirmName</strong> has been sent to that firm's Admin for review.
        You'll receive an email once it's approved (or if it's declined). You can close this page now.
    </div>

    <div class="auth-footer">
        <a class="auth-link" href="/login">Back to Login</a>
    </div>
}
else
{
    <h2>Request to Join a Firm</h2>
    <p class="auth-subtitle">Ask to join an existing firm as Partner, Associate Lawyer, Moharrir, or Intern/Paralegal. That firm's Admin will review and approve your request.</p>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger py-2" style="white-space: pre-line;">@_errorMessage</div>
    }

    @if (_isLoadingFirms)
    {
        <div class="text-center py-3"><span class="spinner-border spinner-border-sm"></span></div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Firm</label>
                <select class="form-select" @bind="_model.FirmID">
                    <option value="0">-- Select the firm you want to join --</option>
                    @foreach (var firm in _firms)
                    {
                        <option value="@firm.FirmID">@firm.FirmName (@firm.FirmCode)</option>
                    }
                </select>
                <ValidationMessage For="() => _model.FirmID" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Role You're Requesting</label>
                <select class="form-select" @bind="_model.RequestedRoleID">
                    <option value="0">-- Select a role --</option>
                    @foreach (var role in UserRoleExtensions.AssignableByFirmAdmin)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
                <ValidationMessage For="() => _model.RequestedRoleID" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" placeholder="Enter your full name"
                       @bind="_model.FullName" @bind:event="oninput" required />
                <ValidationMessage For="() => _model.FullName" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" placeholder="Enter your email address"
                       @bind="_model.Email" @bind:event="oninput" required />
                <ValidationMessage For="() => _model.Email" class="text-danger small" />
            </div>

            <div class="mb-3 password-toggle-wrap">
                <label class="form-label">Password</label>
                <input type="@(_showPassword ? "text" : "password")" class="form-control"
                       placeholder="At least 8 characters, mixed case, number & symbol"
                       @bind="_model.Password" @bind:event="oninput" required />
                <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showPassword = !_showPassword">
                    <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
                <ValidationMessage For="() => _model.Password" class="text-danger small" />
            </div>

            <div class="mb-3 password-toggle-wrap">
                <label class="form-label">Confirm Password</label>
                <input type="@(_showConfirmPassword ? "text" : "password")" class="form-control"
                       placeholder="Re-enter your password"
                       @bind="_model.ConfirmPassword" @bind:event="oninput" required />
                <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                    <i class="bi @(_showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                </button>
                <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Phone <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" class="form-control" placeholder="03xx-xxxxxxx"
                           @bind="_model.Phone" @bind:event="oninput" />
                    <ValidationMessage For="() => _model.Phone" class="text-danger small" />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Department <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Litigation"
                           @bind="_model.Department" @bind:event="oninput" />
                    <ValidationMessage For="() => _model.Department" class="text-danger small" />
                </div>
            </div>

            <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
                @if (_isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Submit Request
            </button>
        </EditForm>
    }

    <div class="auth-footer">
        Already have an account? <a class="auth-link" href="/login">Sign in</a>
    </div>
    <div class="auth-footer">
        Starting a brand-new firm instead? <a class="auth-link" href="/request-firm-admin">Request Firm Admin access</a>
    </div>
}

@code {
    private readonly SubmitUserJoinRequest _model = new();
    private List<JoinableFirmDTO> _firms = new();
    private bool _isLoadingFirms = true;
    private bool _isBusy;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private string? _errorMessage;

    private bool _submitted;
    private string _submittedFirmName = string.Empty;
    private string _submittedName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _firms = await UserJoinRequestService.GetJoinableFirmsAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Firm list load nahi ho saki. Please refresh and try again.";
        }
        finally
        {
            _isLoadingFirms = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await UserJoinRequestService.SubmitAsync(_model);
            _submittedFirmName = _firms.FirstOrDefault(f => f.FirmID == _model.FirmID)?.FirmName ?? "the selected firm";
            _submittedName = _model.FullName;
            _submitted = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Request nahi bhej saka. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
