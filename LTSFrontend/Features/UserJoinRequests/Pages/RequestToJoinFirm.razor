@page "/request-to-join"
@layout LTSFrontend.Layout.LoginLayout
@using LTSFrontend.Core.Enums
@using LTSFrontend.Features.UserJoinRequests.DTOs
@using LTSFrontend.Features.UserJoinRequests.Services
@inject IUserJoinRequestService UserJoinRequestService
@inject NavigationManager Navigation

<PageTitle>Request to Join a Firm - LTS</PageTitle>

@if (_submitted)
{
    <h2>Request Submitted</h2>
    <p class="auth-subtitle">Thank you, @_submittedName.</p>

    <div class="alert alert-success py-2">
        Your request to join <strong>@_submittedFirmName</strong> has been sent to that firm's Admin for review.
        You'll receive an email once it's approved (or if it's declined). You can close this page now.
    </div>

    <div class="auth-footer">
        <a class="auth-link" href="/login">Back to Login</a>
    </div>
}
else
{
    <h2>Request to Join a Firm</h2>
    <p class="auth-subtitle">Enter your firm's code and your details. Your firm's Admin will review and approve your request.</p>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger py-2" style="white-space: pre-line;">@_errorMessage</div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Firm Code</label>
                <input type="text" class="form-control" placeholder="e.g. ALPHA-LAW"
                       value="@_firmCode" @oninput="OnFirmCodeInput" disabled="@(_isLoadingFirms || _isBusy)" autofocus required />
                @if (_isLoadingFirms)
                {
                    <div class="form-text">Checking firm code…</div>
                }
                else if (!string.IsNullOrWhiteSpace(_firmCode) && _model.FirmID <= 0)
                {
                    <div class="text-danger small">Firm code not recognized.</div>
                }
                <ValidationMessage For="() => _model.FirmID" class="text-danger small" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" placeholder="Enter your full name"
                       @bind="_model.FullName" @bind:event="oninput" disabled="@_isBusy" required />
                <ValidationMessage For="() => _model.FullName" class="text-danger small" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="Enter your email address"
                   @bind="_model.Email" @bind:event="oninput" disabled="@_isBusy" required />
            <ValidationMessage For="() => _model.Email" class="text-danger small" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Password</label>
                <div class="password-toggle-wrap">
                    <input type="@(_showPassword ? "text" : "password")" class="form-control"
                           placeholder="8+ chars, mixed case, number & symbol"
                           @bind="_model.Password" @bind:event="oninput" disabled="@_isBusy" required />
                    <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showPassword = !_showPassword">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" class="text-danger small" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Confirm Password</label>
                <div class="password-toggle-wrap">
                    <input type="@(_showConfirmPassword ? "text" : "password")" class="form-control"
                           placeholder="Re-enter your password"
                           @bind="_model.ConfirmPassword" @bind:event="oninput" disabled="@_isBusy" required />
                    <button type="button" class="password-toggle-btn" tabindex="-1" @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                        <i class="bi @(_showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
            </div>
        </div>

        <button type="submit" class="btn btn-auth-primary" disabled="@_isBusy">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            Submit Request
        </button>
    </EditForm>

    <div class="auth-footer">
        Already have an account? <a class="auth-link" href="/login">Sign in</a>
    </div>
    <div class="auth-footer">
        Starting a brand-new firm instead? <a class="auth-link" href="/request-firm-admin">Request Firm Admin access</a>
    </div>
}

@code {
    // Firm and Role are never chosen by the requester: FirmID is resolved
    // from the Firm Code they type (matched against the firm list fetched
    // quietly in the background - never rendered as a public dropdown of
    // every firm on the platform), and RequestedRoleID is always fixed to
    // Intern/Paralegal. Only Firm Code, Full Name, Email and Password are
    // essential, user-entered fields. A Firm Admin reviews the request
    // afterward and can promote the role post-approval.
    private readonly SubmitUserJoinRequest _model = new()
    {
        RequestedRoleID = (int)UserRole.InternParalegal
    };

    private List<JoinableFirmDTO> _firms = new();
    private string _firmCode = string.Empty;
    private bool _isLoadingFirms = true;
    private bool _isBusy;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private string? _errorMessage;

    private bool _submitted;
    private string _submittedFirmName = string.Empty;
    private string _submittedName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _firms = await UserJoinRequestService.GetJoinableFirmsAsync();
        }
        catch (Exception)
        {
            _errorMessage = "Firm list load nahi ho saki. Please refresh and try again.";
        }
        finally
        {
            _isLoadingFirms = false;
        }
    }

    private void OnFirmCodeInput(ChangeEventArgs e)
    {
        _firmCode = e.Value?.ToString() ?? string.Empty;

        var match = _firms.FirstOrDefault(f =>
            string.Equals(f.FirmCode?.Trim(), _firmCode.Trim(), StringComparison.OrdinalIgnoreCase));

        _model.FirmID = match?.FirmID ?? 0;
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        // Defensive: RequestedRoleID must always be Intern/Paralegal, no
        // matter what - there is no UI path that can change it, but this
        // guarantees it even if the model is ever reused/rebound.
        _model.RequestedRoleID = (int)UserRole.InternParalegal;

        if (_model.FirmID <= 0)
        {
            _errorMessage = "Please enter a valid firm code before submitting.";
            return;
        }

        _isBusy = true;
        try
        {
            await UserJoinRequestService.SubmitAsync(_model);
            _submittedFirmName = _firms.FirstOrDefault(f => f.FirmID == _model.FirmID)?.FirmName ?? "the selected firm";
            _submittedName = _model.FullName;
            _submitted = true;
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _errorMessage = "Request nahi bhej saka. Please try again.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
