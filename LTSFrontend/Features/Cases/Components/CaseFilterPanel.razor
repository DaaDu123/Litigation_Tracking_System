@* Reusable filter/toolbar strip for the case list - search box, Court/Status/
   Priority dropdowns, page-size selector, and the table/grid view toggle.
   Extracted out of CaseList.razor so any other case-listing screen (e.g. a
   future "My Assigned Cases" filter bar) can reuse the exact same controls
   instead of re-building them inline. *@
@using LTSFrontend.Features.Masters.DTOs
@using LTSFrontend.Shared.Components

<div class="lts-toolbar" style="padding: 1rem 1.1rem 0;">
    <div class="lts-toolbar-left">
        <SearchBox Value="SearchTerm" ValueChanged="OnSearchTermChanged"
                   Placeholder="Search by case number, title, or reference..." />

        <select class="lts-select" value="@CourtFilter" @onchange="OnCourtChanged">
            <option value="0">All Courts</option>
            @foreach (var court in Courts)
            {
                <option value="@court.CourtID">@court.CourtName</option>
            }
        </select>

        <select class="lts-select" value="@StatusFilter" @onchange="OnStatusChanged">
            <option value="0">All Statuses</option>
            @foreach (var status in Statuses)
            {
                <option value="@status.StatusID">@status.StatusName</option>
            }
        </select>

        <select class="lts-select" value="@PriorityFilter" @onchange="OnPriorityChanged">
            <option value="">All Priorities</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>
    </div>
    <div class="lts-toolbar-right">
        <select class="lts-select" value="@PageSize" @onchange="OnPageSizeChanged" style="min-width:110px;">
            <option value="10">10 / page</option>
            <option value="25">25 / page</option>
            <option value="50">50 / page</option>
        </select>

        <div class="lts-view-toggle">
            <button class="@(ViewMode == "table" ? "active" : "")" title="Table view" @onclick='() => SetViewMode("table")'>
                <i class="bi bi-table"></i>
            </button>
            <button class="@(ViewMode == "grid" ? "active" : "")" title="Card view" @onclick='() => SetViewMode("grid")'>
                <i class="bi bi-grid-3x3-gap"></i>
            </button>
        </div>

        <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="() => OnRefresh.InvokeAsync()" title="Refresh" disabled="@IsLoading">
            <i class="bi bi-arrow-clockwise @(IsLoading ? "spin" : "")"></i>
        </button>
    </div>
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }

    [Parameter] public int CourtFilter { get; set; }
    [Parameter] public EventCallback<int> CourtFilterChanged { get; set; }

    [Parameter] public int StatusFilter { get; set; }
    [Parameter] public EventCallback<int> StatusFilterChanged { get; set; }

    [Parameter] public string PriorityFilter { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PriorityFilterChanged { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter] public string ViewMode { get; set; } = "table";
    [Parameter] public EventCallback<string> ViewModeChanged { get; set; }

    [Parameter, EditorRequired] public List<CourtDTO> Courts { get; set; } = new();
    [Parameter, EditorRequired] public List<CaseStatusDTO> Statuses { get; set; } = new();

    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Raised after any filter/page-size change - the parent re-queries page 1.</summary>
    [Parameter] public EventCallback OnFilterChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private async Task OnSearchTermChanged(string value)
    {
        SearchTerm = value;
        await SearchTermChanged.InvokeAsync(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task OnCourtChanged(ChangeEventArgs e)
    {
        var value = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        CourtFilter = value;
        await CourtFilterChanged.InvokeAsync(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var value = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        StatusFilter = value;
        await StatusFilterChanged.InvokeAsync(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task OnPriorityChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        PriorityFilter = value;
        await PriorityFilterChanged.InvokeAsync(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        var value = int.TryParse(e.Value?.ToString(), out var v) ? v : 10;
        PageSize = value;
        await PageSizeChanged.InvokeAsync(value);
        await OnFilterChanged.InvokeAsync();
    }

    private async Task SetViewMode(string mode)
    {
        ViewMode = mode;
        await ViewModeChanged.InvokeAsync(mode);
    }
}
