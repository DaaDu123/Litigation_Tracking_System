@* Modal for adding/editing a case milestone.
   Usage:
     <MilestoneModal @ref="_milestoneModal" OnSaved="HandleSavedAsync" />
     _milestoneModal.OpenForCreate(caseId);
     _milestoneModal.OpenForEdit(milestone); *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Milestones.DTOs
@using LTSFrontend.Features.Milestones.Services
@inject IMilestoneService MilestoneService

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="CloseIfNotSaving"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal lts-modal-sm" @onclick:stopPropagation="true">
        <div class="lts-modal-header">
            <div class="lts-modal-icon lts-modal-icon-primary">
                <i class="bi bi-flag"></i>
            </div>
            <div>
                <h5 class="lts-modal-title">@(_isEdit ? "Edit Milestone" : "Add Milestone")</h5>
            </div>
        </div>

        <div class="lts-modal-body">
            @if (!string.IsNullOrWhiteSpace(_apiError))
            {
                <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm);">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@_apiError</span>
                </div>
            }

            <div class="lts-form-group">
                <label class="lts-form-label">Milestone <span class="required">*</span></label>
                <input class="lts-form-control" @bind="_form.Milestone" disabled="@_isSaving"
                       placeholder="e.g. Written Statement Filed, Judgment Reserved..." />
                @if (_showValidation && string.IsNullOrWhiteSpace(_form.Milestone))
                {
                    <div class="lts-form-error">Milestone name is required.</div>
                }
            </div>

            <div class="lts-form-group">
                <label class="lts-form-label">Milestone Date <span class="required">*</span></label>
                <input type="date" class="lts-form-control"
                       value="@(_form.MilestoneDate?.ToString("yyyy-MM-dd"))"
                       @onchange="OnMilestoneDateChanged" disabled="@_isSaving" />
            </div>

            <div class="lts-form-group">
                <label class="lts-form-label">Description</label>
                <textarea class="lts-form-control" rows="3" @bind="_form.Description" disabled="@_isSaving"></textarea>
            </div>
        </div>

        <div class="lts-modal-footer">
            <button type="button" class="lts-btn lts-btn-ghost" @onclick="CloseIfNotSaving" disabled="@_isSaving">Cancel</button>
            <button type="button" class="lts-btn lts-btn-primary" @onclick="HandleSubmitAsync" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="lts-spinner lts-spinner-sm"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>
                    <span>@(_isEdit ? "Save Changes" : "Add Milestone")</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _isOpen;
    private bool _isEdit;
    private bool _isSaving;
    private bool _showValidation;
    private string? _apiError;

    private MilestoneFormDTO _form = new();

    public void OpenForCreate(long caseId)
    {
        _isEdit = false;
        _form = new MilestoneFormDTO { CaseID = caseId };
        ResetAndOpen();
    }

    public void OpenForEdit(MilestoneDTO milestone)
    {
        _isEdit = true;
        _form = new MilestoneFormDTO
        {
            MilestoneID = milestone.MilestoneID,
            CaseID = milestone.CaseID,
            Milestone = milestone.Milestone,
            MilestoneDate = milestone.MilestoneDate,
            Description = milestone.Description
        };
        ResetAndOpen();
    }

    private void ResetAndOpen()
    {
        _apiError = null;
        _showValidation = false;
        _isOpen = true;
        StateHasChanged();
    }

    private void OnMilestoneDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            _form.MilestoneDate = dt;
    }

    private void CloseIfNotSaving()
    {
        if (_isSaving) return;
        _isOpen = false;
        StateHasChanged();
    }

    private async Task HandleSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Milestone) || _form.MilestoneDate is null)
        {
            _showValidation = true;
            return;
        }

        _isSaving = true;
        _apiError = null;
        try
        {
            if (_isEdit)
                await MilestoneService.UpdateAsync(_form);
            else
                await MilestoneService.CreateAsync(_form);

            _isOpen = false;
            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _apiError = "Something went wrong while saving the milestone. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
