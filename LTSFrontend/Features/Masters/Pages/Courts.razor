@page "/masters/courts"
@attribute [Authorize(Roles = "FirmAdmin")]
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Masters.Components
@using LTSFrontend.Features.Masters.Models
@using LTSFrontend.Features.Masters.Services
@using LTSFrontend.Shared.Components
@using LTSFrontend.State
@using Microsoft.AspNetCore.Authorization
@inject ICourtService CourtService
@inject ToastService Toast

<PageTitle>Courts - Master Data - LTS</PageTitle>

<div class="lts-breadcrumb">
    <a href="/masters">Master Data</a>
    <i class="bi bi-chevron-right" style="font-size:0.65rem;"></i>
    <span class="current">Courts</span>
</div>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">Courts</h1>
        <p class="lts-page-subtitle">Manage the courts and tribunals referenced across cases and hearings.</p>
    </div>
    <div class="lts-page-header-actions">
        <PermissionGate Roles="FirmAdmin,SuperAdmin">
            <button class="lts-btn lts-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> Add Court
            </button>
        </PermissionGate>
    </div>
</div>

<!-- Stat cards -->
<div class="lts-stat-grid">
    <div class="lts-stat-card" style="--accent:#1b4fd6;">
        <div class="lts-stat-icon"><i class="bi bi-bank"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allCourts.Count.ToString())</div>
            <div class="lts-stat-label">Total Courts</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#16a34a;">
        <div class="lts-stat-icon"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allCourts.Count(c => c.IsActive).ToString())</div>
            <div class="lts-stat-label">Active</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#6b7280;">
        <div class="lts-stat-icon"><i class="bi bi-slash-circle"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allCourts.Count(c => !c.IsActive).ToString())</div>
            <div class="lts-stat-label">Inactive</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#0284c7;">
        <div class="lts-stat-icon"><i class="bi bi-tags"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : DistinctTypeCount.ToString())</div>
            <div class="lts-stat-label">Court Types</div>
        </div>
    </div>
</div>

<div class="lts-card p-0">
    <!-- Toolbar -->
    <div class="lts-toolbar" style="padding: 1rem 1.1rem 0;">
        <div class="lts-toolbar-left">
            <SearchBox @bind-Value="_searchTerm" @bind-Value:after="ResetToFirstPage" Placeholder="Search by name, type, or jurisdiction..." />
            <select class="lts-select" @bind="_statusFilter" @bind:after="ResetToFirstPage">
                <option value="all">All Statuses</option>
                <option value="active">Active only</option>
                <option value="inactive">Inactive only</option>
            </select>

            <select class="lts-select" @bind="_typeFilter" @bind:after="ResetToFirstPage">
                <option value="all">All Types</option>
                @foreach (var type in AvailableTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="lts-toolbar-right">
            <select class="lts-select" @bind="_pageSize" @bind:after="ResetToFirstPage" style="min-width:110px;">
                <option value="10">10 / page</option>
                <option value="25">25 / page</option>
                <option value="50">50 / page</option>
            </select>

            <div class="lts-view-toggle">
                <button class="@(_viewMode == "table" ? "active" : "")" title="Table view" @onclick='() => _viewMode = "table"'>
                    <i class="bi bi-table"></i>
                </button>
                <button class="@(_viewMode == "grid" ? "active" : "")" title="Card view" @onclick='() => _viewMode = "grid"'>
                    <i class="bi bi-grid-3x3-gap"></i>
                </button>
            </div>

            <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="LoadAsync" title="Refresh" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "spin" : "")"></i>
            </button>
        </div>
    </div>

    <div style="padding: 1rem 1.1rem;">
        @if (_isLoading)
        {
            @if (_viewMode == "table")
            {
                <div class="lts-table-wrap">
                    <table class="lts-table">
                        <thead>
                            <tr>
                                <th>Court Name</th><th>Type</th><th>Jurisdiction</th><th>Status</th><th>Created</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < 5; i++)
                            {
                                <tr class="lts-skeleton-row">
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:70%;"></div></td>
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:60%;"></div></td>
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:50%;"></div></td>
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:40%;"></div></td>
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:55%;"></div></td>
                                    <td><div class="lts-skeleton lts-skeleton-text" style="width:2rem;"></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="lts-grid-view">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="lts-entity-card">
                            <div class="lts-skeleton lts-skeleton-text" style="width:70%; height:1rem;"></div>
                            <div class="lts-skeleton lts-skeleton-text" style="width:50%;"></div>
                            <div class="lts-skeleton lts-skeleton-text" style="width:90%;"></div>
                        </div>
                    }
                </div>
            }
        }
        else if (_hasError)
        {
            <div class="lts-state is-error">
                <div class="lts-state-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="lts-state-title">Couldn't load courts</div>
                <div class="lts-state-desc">@_errorMessage</div>
                <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="LoadAsync">
                    <i class="bi bi-arrow-clockwise"></i> Try Again
                </button>
            </div>
        }
        else if (FilteredCourts.Count == 0)
        {
            <div class="lts-state">
                <div class="lts-state-icon"><i class="bi bi-bank"></i></div>
                <div class="lts-state-title">
                    @(_allCourts.Count == 0 ? "No courts yet" : "No matching courts")
                </div>
                <div class="lts-state-desc">
                    @(_allCourts.Count == 0
                        ? "Add your first court to start linking cases and hearings to it."
                        : "Try adjusting your search or filters.")
                </div>
                @if (_allCourts.Count == 0)
                {
                    <PermissionGate Roles="FirmAdmin,SuperAdmin">
                        <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="OpenCreate">
                            <i class="bi bi-plus-lg"></i> Add Court
                        </button>
                    </PermissionGate>
                }
                else
                {
                    <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="ClearFilters">
                        <i class="bi bi-x-lg"></i> Clear Filters
                    </button>
                }
            </div>
        }
        else if (_viewMode == "table")
        {
            <div class="lts-table-wrap">
                <table class="lts-table">
                    <thead>
                        <tr>
                            <th class="sortable @(_sortField == "name" ? "active" : "")" @onclick='() => Sort("name")'>
                                Court Name <i class="bi @SortIcon("name")"></i>
                            </th>
                            <th class="sortable @(_sortField == "type" ? "active" : "")" @onclick='() => Sort("type")'>
                                Type <i class="bi @SortIcon("type")"></i>
                            </th>
                            <th class="sortable @(_sortField == "jurisdiction" ? "active" : "")" @onclick='() => Sort("jurisdiction")'>
                                Jurisdiction <i class="bi @SortIcon("jurisdiction")"></i>
                            </th>
                            <th>Status</th>
                            <th class="sortable @(_sortField == "created" ? "active" : "")" @onclick='() => Sort("created")'>
                                Created <i class="bi @SortIcon("created")"></i>
                            </th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var court in PagedCourts)
                        {
                            <tr @key="court.CourtID">
                                <td class="lts-cell-primary">@court.CourtName</td>
                                <td class="lts-cell-muted">@(court.CourtType ?? "—")</td>
                                <td class="lts-cell-muted">@(court.Jurisdiction ?? "—")</td>
                                <td><StatusBadge IsActive="court.IsActive" /></td>
                                <td class="lts-cell-muted">@court.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="lts-row-actions">
                                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="View" @onclick="() => OpenDetails(court)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <PermissionGate Roles="FirmAdmin,SuperAdmin">
                                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Edit" @onclick="() => OpenEdit(court)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Delete" @onclick="() => HandleDeleteAsync(court)">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </PermissionGate>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination CurrentPage="_currentPage" TotalItems="FilteredCourts.Count" PageSize="_pageSize" PageChanged="OnPageChanged" />
            </div>
        }
        else
        {
            <div class="lts-grid-view">
                @foreach (var court in PagedCourts)
                {
                    <div class="lts-entity-card" @key="court.CourtID">
                        <div class="lts-entity-card-header">
                            <h3 class="lts-entity-card-title">@court.CourtName</h3>
                            <StatusBadge IsActive="court.IsActive" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(court.CourtType))
                        {
                            <div class="lts-entity-card-meta"><i class="bi bi-tag"></i>@court.CourtType</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(court.Jurisdiction))
                        {
                            <div class="lts-entity-card-meta"><i class="bi bi-geo-alt"></i>@court.Jurisdiction</div>
                        }
                        <div class="lts-entity-card-meta"><i class="bi bi-calendar3"></i>Added @court.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</div>

                        <div class="lts-entity-card-footer">
                            <button class="lts-btn lts-btn-ghost lts-btn-sm" @onclick="() => OpenDetails(court)">
                                <i class="bi bi-eye"></i> View
                            </button>
                            <PermissionGate Roles="FirmAdmin,SuperAdmin">
                                <div class="lts-row-actions">
                                    <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Edit" @onclick="() => OpenEdit(court)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Delete" @onclick="() => HandleDeleteAsync(court)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </div>
                            </PermissionGate>
                        </div>
                    </div>
                }
            </div>
            <Pagination CurrentPage="_currentPage" TotalItems="FilteredCourts.Count" PageSize="_pageSize" PageChanged="OnPageChanged" />
        }
    </div>
</div>

<CourtFormModal @ref="_formModal" OnSaved="HandleSavedAsync" />
<CourtDetailsModal @ref="_detailsModal" OnEditRequested="OpenEdit" />
<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<CourtDTO> _allCourts = new();
    private bool _isLoading = true;
    private bool _hasError;
    private string? _errorMessage;

    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string _typeFilter = "all";
    private string _sortField = "name";
    private bool _sortAsc = true;
    private string _viewMode = "table";

    private int _currentPage = 1;
    private int _pageSize = 10;

    private CourtFormModal _formModal = default!;
    private CourtDetailsModal _detailsModal = default!;
    private ConfirmDialog _confirmDialog = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        try
        {
            _allCourts = await CourtService.GetAllAsync(activeOnly: false);
        }
        catch (ApiException ex)
        {
            _hasError = true;
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Courts could not be loaded. Please check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<string> AvailableTypes =>
        _allCourts.Where(c => !string.IsNullOrWhiteSpace(c.CourtType))
            .Select(c => c.CourtType!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t);

    private int DistinctTypeCount => AvailableTypes.Count();

    private List<CourtDTO> FilteredCourts
    {
        get
        {
            IEnumerable<CourtDTO> query = _allCourts;

            if (_statusFilter == "active") query = query.Where(c => c.IsActive);
            else if (_statusFilter == "inactive") query = query.Where(c => !c.IsActive);

            if (_typeFilter != "all")
                query = query.Where(c => string.Equals(c.CourtType, _typeFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(c =>
                    c.CourtName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (c.CourtType != null && c.CourtType.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (c.Jurisdiction != null && c.Jurisdiction.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            query = _sortField switch
            {
                "type" => _sortAsc ? query.OrderBy(c => c.CourtType) : query.OrderByDescending(c => c.CourtType),
                "jurisdiction" => _sortAsc ? query.OrderBy(c => c.Jurisdiction) : query.OrderByDescending(c => c.Jurisdiction),
                "created" => _sortAsc ? query.OrderBy(c => c.CreatedDate) : query.OrderByDescending(c => c.CreatedDate),
                _ => _sortAsc ? query.OrderBy(c => c.CourtName) : query.OrderByDescending(c => c.CourtName),
            };

            return query.ToList();
        }
    }

    private List<CourtDTO> PagedCourts =>
        FilteredCourts.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private void Sort(string field)
    {
        if (_sortField == field) _sortAsc = !_sortAsc;
        else { _sortField = field; _sortAsc = true; }
    }

    private string SortIcon(string field) =>
        _sortField != field ? "bi-arrow-down-up" : (_sortAsc ? "bi-sort-alpha-down" : "bi-sort-alpha-up");

    private Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        ResetToFirstPage();
        return Task.CompletedTask;
    }

    private void ResetToFirstPage() => _currentPage = 1;

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _statusFilter = "all";
        _typeFilter = "all";
        _currentPage = 1;
    }

    private Task OnPageChanged(int page)
    {
        _currentPage = page;
        return Task.CompletedTask;
    }

    private void OpenCreate() => _formModal.OpenForCreate();

    private void OpenEdit(CourtDTO court) => _formModal.OpenForEdit(court);

    private void OpenDetails(CourtDTO court) => _detailsModal.Open(court);

    private async Task HandleSavedAsync(bool wasEdit)
    {
        await LoadAsync();
        Toast.Success(wasEdit ? "Court updated" : "Court created",
            wasEdit ? "The court's details have been saved." : "The new court is now available for cases and hearings.");
    }

    private async Task HandleDeleteAsync(CourtDTO court)
    {
        var confirmed = await _confirmDialog.ShowAsync(
            $"Delete \"{court.CourtName}\"?",
            "This cannot be undone. Courts linked to existing cases or hearings cannot be deleted.",
            "Delete", "danger");

        if (!confirmed) return;

        try
        {
            await CourtService.DeleteAsync(court.CourtID);
            await LoadAsync();
            Toast.Success("Court deleted", $"\"{court.CourtName}\" has been removed.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't delete court", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't delete court", "Please try again.");
        }
    }
}
