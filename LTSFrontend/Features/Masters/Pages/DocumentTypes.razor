@page "/masters/document-types"
@attribute [Authorize(Roles = "FirmAdmin")]
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Masters.Components
@using LTSFrontend.Features.Masters.Models
@using LTSFrontend.Features.Masters.Services
@using LTSFrontend.Shared.Components
@using LTSFrontend.State
@using Microsoft.AspNetCore.Authorization
@inject IDocumentTypeService DocumentTypeService
@inject ToastService Toast

<PageTitle>Document Types - Master Data - LTS</PageTitle>

<div class="lts-breadcrumb">
    <a href="/masters">Master Data</a>
    <i class="bi bi-chevron-right" style="font-size:0.65rem;"></i>
    <span class="current">Document Types</span>
</div>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">Document Types</h1>
        <p class="lts-page-subtitle">Categorize uploaded documents by type.</p>
    </div>
    <div class="lts-page-header-actions">
        <PermissionGate Roles="FirmAdmin,SuperAdmin">
            <button class="lts-btn lts-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> Add Document Type
            </button>
        </PermissionGate>
    </div>
</div>

<div class="lts-stat-grid">
    <div class="lts-stat-card" style="--accent:#1b4fd6;">
        <div class="lts-stat-icon"><i class="bi bi-file-earmark-text"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allTypes.Count.ToString())</div>
            <div class="lts-stat-label">Total Types</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#16a34a;">
        <div class="lts-stat-icon"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allTypes.Count(c => c.IsActive).ToString())</div>
            <div class="lts-stat-label">Active</div>
        </div>
    </div>
    <div class="lts-stat-card" style="--accent:#6b7280;">
        <div class="lts-stat-icon"><i class="bi bi-slash-circle"></i></div>
        <div>
            <div class="lts-stat-value">@(_isLoading ? "-" : _allTypes.Count(c => !c.IsActive).ToString())</div>
            <div class="lts-stat-label">Inactive</div>
        </div>
    </div>
</div>

<div class="lts-card p-0">
    <div class="lts-toolbar" style="padding: 1rem 1.1rem 0;">
        <div class="lts-toolbar-left">
            <SearchBox @bind-Value="_searchTerm" @bind-Value:after="ResetToFirstPage" Placeholder="Search by name or description..." />
            <select class="lts-select" @bind="_statusFilter" @bind:after="ResetToFirstPage">
                <option value="all">All Statuses</option>
                <option value="active">Active only</option>
                <option value="inactive">Inactive only</option>
            </select>
        </div>
        <div class="lts-toolbar-right">
            <select class="lts-select" @bind="_pageSize" @bind:after="ResetToFirstPage" style="min-width:110px;">
                <option value="10">10 / page</option>
                <option value="25">25 / page</option>
                <option value="50">50 / page</option>
            </select>
            <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="LoadAsync" title="Refresh" disabled="@_isLoading">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "spin" : "")"></i>
            </button>
        </div>
    </div>

    <div style="padding: 1rem 1.1rem;">
        @if (_isLoading)
        {
            <div class="lts-table-wrap">
                <table class="lts-table">
                    <thead>
                        <tr><th>Type Name</th><th>Description</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr class="lts-skeleton-row">
                                <td><div class="lts-skeleton lts-skeleton-text" style="width:70%;"></div></td>
                                <td><div class="lts-skeleton lts-skeleton-text" style="width:60%;"></div></td>
                                <td><div class="lts-skeleton lts-skeleton-text" style="width:40%;"></div></td>
                                <td><div class="lts-skeleton lts-skeleton-text" style="width:2rem;"></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_hasError)
        {
            <div class="lts-state is-error">
                <div class="lts-state-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="lts-state-title">Couldn't load document types</div>
                <div class="lts-state-desc">@_errorMessage</div>
                <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="LoadAsync">
                    <i class="bi bi-arrow-clockwise"></i> Try Again
                </button>
            </div>
        }
        else if (FilteredTypes.Count == 0)
        {
            <div class="lts-state">
                <div class="lts-state-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="lts-state-title">
                    @(_allTypes.Count == 0 ? "No document types yet" : "No matching document types")
                </div>
                <div class="lts-state-desc">
                    @(_allTypes.Count == 0
                        ? "Add your first document type to start categorizing uploads."
                        : "Try adjusting your search or filters.")
                </div>
                @if (_allTypes.Count == 0)
                {
                    <PermissionGate Roles="FirmAdmin,SuperAdmin">
                        <button class="lts-btn lts-btn-primary lts-btn-sm" @onclick="OpenCreate">
                            <i class="bi bi-plus-lg"></i> Add Document Type
                        </button>
                    </PermissionGate>
                }
                else
                {
                    <button class="lts-btn lts-btn-outline lts-btn-sm" @onclick="ClearFilters">
                        <i class="bi bi-x-lg"></i> Clear Filters
                    </button>
                }
            </div>
        }
        else
        {
            <div class="lts-table-wrap">
                <table class="lts-table">
                    <thead>
                        <tr>
                            <th class="sortable @(_sortField == "name" ? "active" : "")" @onclick='() => Sort("name")'>
                                Type Name <i class="bi @SortIcon("name")"></i>
                            </th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in PagedTypes)
                        {
                            <tr @key="type.DocumentTypeID">
                                <td class="lts-cell-primary">@type.TypeName</td>
                                <td class="lts-cell-muted">@(string.IsNullOrWhiteSpace(type.Description) ? "—" : type.Description)</td>
                                <td><StatusBadge IsActive="type.IsActive" /></td>
                                <td>
                                    <div class="lts-row-actions">
                                        <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="View" @onclick="() => OpenDetails(type)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <PermissionGate Roles="FirmAdmin,SuperAdmin">
                                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Edit" @onclick="() => OpenEdit(type)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="lts-btn lts-btn-ghost lts-btn-sm lts-btn-icon-only" title="Delete" @onclick="() => HandleDeleteAsync(type)">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </PermissionGate>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pagination CurrentPage="_currentPage" TotalItems="FilteredTypes.Count" PageSize="_pageSize" PageChanged="OnPageChanged" />
            </div>
        }
    </div>
</div>

<DocumentTypeFormModal @ref="_formModal" OnSaved="HandleSavedAsync" />
<DocumentTypeDetailsModal @ref="_detailsModal" OnEditRequested="OpenEdit" />
<ConfirmDialog @ref="_confirmDialog" />

@code {
    private List<DocumentTypeDTO> _allTypes = new();
    private bool _isLoading = true;
    private bool _hasError;
    private string? _errorMessage;

    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string _sortField = "name";
    private bool _sortAsc = true;

    private int _currentPage = 1;
    private int _pageSize = 10;

    private DocumentTypeFormModal _formModal = default!;
    private DocumentTypeDetailsModal _detailsModal = default!;
    private ConfirmDialog _confirmDialog = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _errorMessage = null;
        try
        {
            _allTypes = await DocumentTypeService.GetAllAsync(activeOnly: false);
        }
        catch (ApiException ex)
        {
            _hasError = true;
            _errorMessage = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Document types could not be loaded. Please check your connection and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<DocumentTypeDTO> FilteredTypes
    {
        get
        {
            IEnumerable<DocumentTypeDTO> query = _allTypes;

            if (_statusFilter == "active") query = query.Where(c => c.IsActive);
            else if (_statusFilter == "inactive") query = query.Where(c => !c.IsActive);

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(c =>
                    c.TypeName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (c.Description != null && c.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            query = _sortAsc ? query.OrderBy(c => c.TypeName) : query.OrderByDescending(c => c.TypeName);

            return query.ToList();
        }
    }

    private List<DocumentTypeDTO> PagedTypes =>
        FilteredTypes.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private void Sort(string field)
    {
        if (_sortField == field) _sortAsc = !_sortAsc;
        else { _sortField = field; _sortAsc = true; }
    }

    private string SortIcon(string field) =>
        _sortField != field ? "bi-arrow-down-up" : (_sortAsc ? "bi-sort-alpha-down" : "bi-sort-alpha-up");

    private void ResetToFirstPage() => _currentPage = 1;

    private void ClearFilters()
    {
        _searchTerm = string.Empty;
        _statusFilter = "all";
        _currentPage = 1;
    }

    private Task OnPageChanged(int page)
    {
        _currentPage = page;
        return Task.CompletedTask;
    }

    private void OpenCreate() => _formModal.OpenForCreate();

    private void OpenEdit(DocumentTypeDTO type) => _formModal.OpenForEdit(type);

    private void OpenDetails(DocumentTypeDTO type) => _detailsModal.Open(type);

    private async Task HandleSavedAsync(bool wasEdit)
    {
        await LoadAsync();
        Toast.Success(wasEdit ? "Document type updated" : "Document type created",
            wasEdit ? "The document type's details have been saved." : "The new document type is now available for uploads.");
    }

    private async Task HandleDeleteAsync(DocumentTypeDTO type)
    {
        var confirmed = await _confirmDialog.ShowAsync(
            $"Delete \"{type.TypeName}\"?",
            "This cannot be undone. Document types linked to existing documents cannot be deleted.",
            "Delete", "danger");

        if (!confirmed) return;

        try
        {
            await DocumentTypeService.DeleteAsync(type.DocumentTypeID);
            await LoadAsync();
            Toast.Success("Document type deleted", $"\"{type.TypeName}\" has been removed.");
        }
        catch (ApiException ex)
        {
            Toast.Error("Couldn't delete document type", ex.GetFullMessage());
        }
        catch (Exception)
        {
            Toast.Error("Couldn't delete document type", "Please try again.");
        }
    }
}
