@* Create / Edit modal for the Court master. Opened imperatively from Courts.razor
   via @ref: _formModal.OpenForCreate() / OpenForEdit(court). *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Masters.DTOs
@using LTSFrontend.Features.Masters.Services
@inject ICourtService CourtService

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="CloseIfNotSaving"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        <div class="lts-modal-header">
            <div class="lts-modal-icon lts-modal-icon-primary">
                <i class="bi @(_form.IsEditMode ? "bi-pencil-square" : "bi-bank2")"></i>
            </div>
            <div>
                <h5 class="lts-modal-title">@(_form.IsEditMode ? "Edit Court" : "Add New Court")</h5>
                <p class="lts-modal-subtitle mb-0">
                    @(_form.IsEditMode ? "Update this court's details." : "Register a new court in the master list.")
                </p>
            </div>
        </div>

        <div class="lts-modal-body">
            @if (!string.IsNullOrWhiteSpace(_apiError))
            {
                <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm);">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@_apiError</span>
                </div>
            }

            <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div class="lts-form-group">
                    <label class="lts-form-label">Court Name <span class="required">*</span></label>
                    <InputText @bind-Value="_form.CourtName" class="lts-form-control" maxlength="150"
                               placeholder="e.g. Lahore High Court" disabled="@_isSaving" />
                    <div class="d-flex justify-content-between">
                        <ValidationMessage For="() => _form.CourtName" class="lts-form-error" />
                        <span class="lts-char-count">@(_form.CourtName?.Length ?? 0)/150</span>
                    </div>
                </div>

                <div class="lts-form-group">
                    <label class="lts-form-label">Court Type</label>
                    <InputText @bind-Value="_form.CourtType" class="lts-form-control" maxlength="100"
                               placeholder="e.g. High Court" list="court-type-suggestions" disabled="@_isSaving" />
                    <datalist id="court-type-suggestions">
                        @foreach (var type in CourtTypeOptions.Suggestions)
                        {
                            <option value="@type"></option>
                        }
                    </datalist>
                    <ValidationMessage For="() => _form.CourtType" class="lts-form-error" />
                    <div class="lts-form-hint">Start typing to pick a common type, or enter your own.</div>
                </div>

                <div class="lts-form-group">
                    <label class="lts-form-label">Jurisdiction</label>
                    <InputText @bind-Value="_form.Jurisdiction" class="lts-form-control" maxlength="200"
                               placeholder="e.g. Punjab" disabled="@_isSaving" />
                    <ValidationMessage For="() => _form.Jurisdiction" class="lts-form-error" />
                </div>

                <div class="lts-form-group">
                    <label class="lts-form-label">Address</label>
                    <InputTextArea @bind-Value="_form.Address" class="lts-form-control" maxlength="500" rows="3"
                                   placeholder="Street, city, postal details..." disabled="@_isSaving" />
                    <div class="d-flex justify-content-between">
                        <ValidationMessage For="() => _form.Address" class="lts-form-error" />
                        <span class="lts-char-count">@(_form.Address?.Length ?? 0)/500</span>
                    </div>
                </div>

                <div class="lts-switch-row">
                    <div>
                        <div class="fw-semibold" style="font-size:0.88rem;color:var(--lts-text);">Active</div>
                        <div class="lts-form-hint" style="margin-top:0;">Inactive courts are hidden from case/hearing dropdowns.</div>
                    </div>
                    <label class="lts-switch">
                        <InputCheckbox @bind-Value="_form.IsActive" disabled="@_isSaving" />
                        <span class="lts-switch-slider"></span>
                    </label>
                </div>

                <div class="lts-modal-footer" style="padding: 1rem 0 0; margin-top: 0.5rem;">
                    <button type="button" class="lts-btn lts-btn-ghost" @onclick="CloseIfNotSaving" disabled="@_isSaving">
                        Cancel
                    </button>
                    <button type="submit" class="lts-btn lts-btn-primary" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="lts-spinner lts-spinner-sm"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>@(_form.IsEditMode ? "Save Changes" : "Create Court")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnSaved { get; set; } // bool = wasEdit

    private bool _isOpen;
    private bool _isSaving;
    private string? _apiError;
    private CourtFormDTO _form = new();

    public void OpenForCreate()
    {
        _form = new CourtFormDTO { IsActive = true };
        _apiError = null;
        _isOpen = true;
        StateHasChanged();
    }

    public void OpenForEdit(CourtDTO court)
    {
        _form = CourtFormDTO.FromDto(court);
        _apiError = null;
        _isOpen = true;
        StateHasChanged();
    }

    private void CloseIfNotSaving()
    {
        if (_isSaving) return;
        _isOpen = false;
        StateHasChanged();
    }

    private async Task HandleSubmitAsync()
    {
        _isSaving = true;
        _apiError = null;
        try
        {
            var wasEdit = _form.IsEditMode;
            if (wasEdit)
                await CourtService.UpdateAsync(_form);
            else
                await CourtService.CreateAsync(_form);

            _isOpen = false;
            await OnSaved.InvokeAsync(wasEdit);
        }
        catch (ApiException ex)
        {
            _apiError = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _apiError = "Something went wrong while saving the court. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
