@* Read-only "View Details" modal for a single case stage. *@
@using LTSFrontend.Features.Masters.Models
@using LTSFrontend.Shared.Components

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="Close"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        @if (_stage != null)
        {
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-signpost-split"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">@_stage.StageName</h5>
                    <p class="lts-modal-subtitle mb-0">Stage #@_stage.StageID</p>
                </div>
            </div>

            <div class="lts-modal-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <StatusBadge IsActive="_stage.IsActive" />
                </div>

                <dl class="lts-detail-list">
                    <div class="lts-detail-row">
                        <dt>Description</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_stage.Description) ? "—" : _stage.Description)</dd>
                    </div>
                </dl>
            </div>

            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-ghost" @onclick="Close">Close</button>
                <PermissionGate Roles="FirmAdmin,SuperAdmin">
                    <button type="button" class="lts-btn lts-btn-primary" @onclick="RequestEdit">
                        <i class="bi bi-pencil"></i> Edit Stage
                    </button>
                </PermissionGate>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<CaseStageDTO> OnEditRequested { get; set; }

    private bool _isOpen;
    private CaseStageDTO? _stage;

    public void Open(CaseStageDTO stage)
    {
        _stage = stage;
        _isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task RequestEdit()
    {
        if (_stage == null) return;
        _isOpen = false;
        await OnEditRequested.InvokeAsync(_stage);
    }
}
