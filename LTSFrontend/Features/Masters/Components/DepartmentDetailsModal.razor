@* Read-only "View Details" modal for a single department. *@
@using LTSFrontend.Features.Masters.Models
@using LTSFrontend.Shared.Components

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="Close"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        @if (_department != null)
        {
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">@_department.DepartmentName</h5>
                    <p class="lts-modal-subtitle mb-0">Department #@_department.DepartmentID</p>
                </div>
            </div>

            <div class="lts-modal-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <StatusBadge IsActive="_department.IsActive" />
                    @if (!string.IsNullOrWhiteSpace(_department.DepartmentCode))
                    {
                        <span class="lts-scope-pill"><i class="bi bi-hash"></i>@_department.DepartmentCode</span>
                    }
                </div>

                <dl class="lts-detail-list">
                    <div class="lts-detail-row">
                        <dt>Description</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_department.Description) ? "—" : _department.Description)</dd>
                    </div>
                </dl>
            </div>

            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-ghost" @onclick="Close">Close</button>
                <PermissionGate Roles="FirmAdmin,SuperAdmin">
                    <button type="button" class="lts-btn lts-btn-primary" @onclick="RequestEdit">
                        <i class="bi bi-pencil"></i> Edit Department
                    </button>
                </PermissionGate>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<DepartmentDTO> OnEditRequested { get; set; }

    private bool _isOpen;
    private DepartmentDTO? _department;

    public void Open(DepartmentDTO department)
    {
        _department = department;
        _isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task RequestEdit()
    {
        if (_department == null) return;
        _isOpen = false;
        await OnEditRequested.InvokeAsync(_department);
    }
}
