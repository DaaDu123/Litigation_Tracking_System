@* Read-only "View Details" modal for a single document type. *@
@using LTSFrontend.Features.Masters.DTOs
@using LTSFrontend.Shared.Components

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="Close"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        @if (_type != null)
        {
            <div class="lts-modal-header">
                <div class="lts-modal-icon lts-modal-icon-primary">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <div>
                    <h5 class="lts-modal-title">@_type.TypeName</h5>
                    <p class="lts-modal-subtitle mb-0">Document Type #@_type.DocumentTypeID</p>
                </div>
            </div>

            <div class="lts-modal-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <StatusBadge IsActive="_type.IsActive" />
                </div>

                <dl class="lts-detail-list">
                    <div class="lts-detail-row">
                        <dt>Description</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_type.Description) ? "—" : _type.Description)</dd>
                    </div>
                </dl>
            </div>

            <div class="lts-modal-footer">
                <button type="button" class="lts-btn lts-btn-ghost" @onclick="Close">Close</button>
                <PermissionGate Roles="FirmAdmin,SuperAdmin">
                    <button type="button" class="lts-btn lts-btn-primary" @onclick="RequestEdit">
                        <i class="bi bi-pencil"></i> Edit Type
                    </button>
                </PermissionGate>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<DocumentTypeDTO> OnEditRequested { get; set; }

    private bool _isOpen;
    private DocumentTypeDTO? _type;

    public void Open(DocumentTypeDTO type)
    {
        _type = type;
        _isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task RequestEdit()
    {
        if (_type == null) return;
        _isOpen = false;
        await OnEditRequested.InvokeAsync(_type);
    }
}
