@* Create / Edit modal for the Case Status master. Opened imperatively from
   CaseStatuses.razor via @ref: _formModal.OpenForCreate() / OpenForEdit(status). *@
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Masters.Models
@using LTSFrontend.Features.Masters.Services
@inject ICaseStatusService CaseStatusService

<div class="lts-modal-backdrop @(_isOpen ? "show" : "")" @onclick="CloseIfNotSaving"></div>
<div class="lts-modal-wrap @(_isOpen ? "show" : "")" role="dialog" aria-modal="true">
    <div class="lts-modal" @onclick:stopPropagation="true">
        <div class="lts-modal-header">
            <div class="lts-modal-icon lts-modal-icon-primary">
                <i class="bi @(_form.IsEditMode ? "bi-pencil-square" : "bi-flag")"></i>
            </div>
            <div>
                <h5 class="lts-modal-title">@(_form.IsEditMode ? "Edit Case Status" : "Add New Case Status")</h5>
                <p class="lts-modal-subtitle mb-0">
                    @(_form.IsEditMode ? "Update this status's details." : "Register a new case status in the master list.")
                </p>
            </div>
        </div>

        <div class="lts-modal-body">
            @if (!string.IsNullOrWhiteSpace(_apiError))
            {
                <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm);">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@_apiError</span>
                </div>
            }

            <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div class="lts-form-group">
                    <label class="lts-form-label">Status Name <span class="required">*</span></label>
                    <InputText @bind-Value="_form.StatusName" class="lts-form-control" maxlength="100"
                               placeholder="e.g. Pending" disabled="@_isSaving" />
                    <div class="d-flex justify-content-between">
                        <ValidationMessage For="() => _form.StatusName" class="lts-form-error" />
                        <span class="lts-char-count">@(_form.StatusName?.Length ?? 0)/100</span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="lts-form-group mb-0">
                            <label class="lts-form-label">Sequence No <span class="required">*</span></label>
                            <InputNumber @bind-Value="_form.SequenceNo" class="lts-form-control" min="0" disabled="@_isSaving" />
                            <ValidationMessage For="() => _form.SequenceNo" class="lts-form-error" />
                            <div class="lts-form-hint">Controls display order (lowest first).</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="lts-form-group mb-0">
                            <label class="lts-form-label">Color <span class="required">*</span></label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" class="lts-color-input" @bind="_form.ColorCode" @bind:event="oninput" disabled="@_isSaving" />
                                <InputText @bind-Value="_form.ColorCode" class="lts-form-control" maxlength="10" disabled="@_isSaving" />
                            </div>
                            <ValidationMessage For="() => _form.ColorCode" class="lts-form-error" />
                        </div>
                    </div>
                </div>

                <div class="lts-switch-row mt-3">
                    <div>
                        <div class="fw-semibold" style="font-size:0.88rem;color:var(--lts-text);">Closed Status</div>
                        <div class="lts-form-hint" style="margin-top:0;">Cases in this status are treated as closed/finalized.</div>
                    </div>
                    <label class="lts-switch">
                        <InputCheckbox @bind-Value="_form.IsClosed" disabled="@_isSaving" />
                        <span class="lts-switch-slider"></span>
                    </label>
                </div>

                <div class="lts-switch-row">
                    <div>
                        <div class="fw-semibold" style="font-size:0.88rem;color:var(--lts-text);">Active</div>
                        <div class="lts-form-hint" style="margin-top:0;">Inactive statuses are hidden from case dropdowns.</div>
                    </div>
                    <label class="lts-switch">
                        <InputCheckbox @bind-Value="_form.IsActive" disabled="@_isSaving" />
                        <span class="lts-switch-slider"></span>
                    </label>
                </div>

                <div class="lts-modal-footer" style="padding: 1rem 0 0; margin-top: 0.5rem;">
                    <button type="button" class="lts-btn lts-btn-ghost" @onclick="CloseIfNotSaving" disabled="@_isSaving">
                        Cancel
                    </button>
                    <button type="submit" class="lts-btn lts-btn-primary" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="lts-spinner lts-spinner-sm"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>@(_form.IsEditMode ? "Save Changes" : "Create Status")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnSaved { get; set; } // bool = wasEdit

    private bool _isOpen;
    private bool _isSaving;
    private string? _apiError;
    private CaseStatusFormDTO _form = new();

    public void OpenForCreate()
    {
        _form = new CaseStatusFormDTO { IsActive = true, ColorCode = "#1B4FD6" };
        _apiError = null;
        _isOpen = true;
        StateHasChanged();
    }

    public void OpenForEdit(CaseStatusDTO status)
    {
        _form = CaseStatusFormDTO.FromDto(status);
        _apiError = null;
        _isOpen = true;
        StateHasChanged();
    }

    private void CloseIfNotSaving()
    {
        if (_isSaving) return;
        _isOpen = false;
        StateHasChanged();
    }

    private async Task HandleSubmitAsync()
    {
        _isSaving = true;
        _apiError = null;
        try
        {
            var wasEdit = _form.IsEditMode;
            if (wasEdit)
                await CaseStatusService.UpdateAsync(_form);
            else
                await CaseStatusService.CreateAsync(_form);

            _isOpen = false;
            await OnSaved.InvokeAsync(wasEdit);
        }
        catch (ApiException ex)
        {
            _apiError = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _apiError = "Something went wrong while saving the status. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
