@page "/change-password"
@attribute [Authorize]
@using LTSFrontend.Core.Exceptions
@using LTSFrontend.Features.Auth.DTOs
@using LTSFrontend.Features.Auth.Services
@using LTSFrontend.State
@using Microsoft.AspNetCore.Authorization
@inject IAuthService AuthService
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Change Password - LTS</PageTitle>

<div class="lts-page-header">
    <div>
        <h1 class="lts-page-title">Change Password</h1>
        <p class="lts-page-subtitle">Update the password used to sign in to your account.</p>
    </div>
</div>

<div class="lts-card" style="max-width: 480px;">
    @if (!string.IsNullOrWhiteSpace(_apiError))
    {
        <div class="lts-form-error mb-3" style="background: var(--lts-danger-bg); padding: 0.6rem 0.85rem; border-radius: var(--lts-radius-sm); white-space: pre-line;">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@_apiError</span>
        </div>
    }

    @if (_isDone)
    {
        <div class="lts-state">
            <div class="lts-state-icon" style="color: var(--lts-success);"><i class="bi bi-check-circle"></i></div>
            <div class="lts-state-title">Password updated</div>
            <div class="lts-state-desc">Your password has been changed successfully.</div>
            <a href="/profile" class="lts-btn lts-btn-primary lts-btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Profile
            </a>
        </div>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="lts-form-group">
                <label class="lts-form-label">Current Password <span class="required">*</span></label>
                <InputText type="password" @bind-Value="_form.OldPassword" class="lts-form-control" disabled="@_isSaving" />
                <ValidationMessage For="() => _form.OldPassword" class="lts-form-error" />
            </div>

            <div class="lts-form-group">
                <label class="lts-form-label">New Password <span class="required">*</span></label>
                <InputText type="password" @bind-Value="_form.NewPassword" class="lts-form-control" disabled="@_isSaving" />
                <div class="lts-form-hint">At least 8 characters, with uppercase, lowercase, a number, and a symbol.</div>
                <ValidationMessage For="() => _form.NewPassword" class="lts-form-error" />
            </div>

            <div class="lts-form-group">
                <label class="lts-form-label">Confirm New Password <span class="required">*</span></label>
                <InputText type="password" @bind-Value="_form.ConfirmNewPassword" class="lts-form-control" disabled="@_isSaving" />
                <ValidationMessage For="() => _form.ConfirmNewPassword" class="lts-form-error" />
            </div>

            <div class="lts-modal-footer" style="padding: 1.25rem 0 0; margin-top: 0.5rem; justify-content: flex-start; gap: 0.6rem;">
                <button type="submit" class="lts-btn lts-btn-primary" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="lts-spinner lts-spinner-sm"></span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-lock"></i>
                        <span>Update Password</span>
                    }
                </button>
                <a href="/profile" class="lts-btn lts-btn-outline">Cancel</a>
            </div>
        </EditForm>
    }
</div>

@code {
    // Bound to the EditForm; ChangePasswordRequest.Validate() enforces the
    // "new != confirm" and "new != old" checks client-side, the backend's
    // ChangePasswordValidator re-checks everything (including complexity
    // rules) independently as the real source of truth.
    private readonly ChangePasswordRequest _form = new();

    private bool _isSaving;
    private bool _isDone;
    private string? _apiError;

    /// <summary>
    /// Submits the change-password request. On success, shows a
    /// confirmation state instead of navigating away immediately, so the
    /// person has a clear signal the action actually completed - a
    /// silent redirect after a security-sensitive action can feel
    /// unsettling ("did that actually work?").
    /// </summary>
    private async Task HandleSubmitAsync()
    {
        _apiError = null;
        _isSaving = true;
        try
        {
            await AuthService.ChangePasswordAsync(_form);
            _isDone = true;
            Toast.Success("Password changed", "Your password has been updated.");
        }
        catch (ApiException ex)
        {
            _apiError = ex.GetFullMessage();
        }
        catch (Exception)
        {
            _apiError = "Something went wrong while changing your password. Please try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
