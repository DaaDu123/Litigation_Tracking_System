@* Reusable pagination control - purely presentational; the caller owns the paged data. *@
@if (TotalPages > 1)
{
    <div class="lts-pagination">
        <div class="lts-pagination-info">
            Showing <strong>@StartItem</strong>-<strong>@EndItem</strong> of <strong>@TotalItems</strong>
        </div>
        <div class="lts-pagination-controls">
            <button class="lts-page-btn" disabled="@(CurrentPage == 1)" @onclick="() => GoTo(1)" title="First page">
                <i class="bi bi-chevron-bar-left"></i>
            </button>
            <button class="lts-page-btn" disabled="@(CurrentPage == 1)" @onclick="() => GoTo(CurrentPage - 1)" title="Previous page">
                <i class="bi bi-chevron-left"></i>
            </button>

            @foreach (var pageNum in VisiblePages)
            {
                @if (pageNum == -1)
                {
                    <span class="lts-page-ellipsis">…</span>
                }
                else
                {
                    <button class="lts-page-btn @(pageNum == CurrentPage ? "active" : "")" @onclick="() => GoTo(pageNum)">
                        @pageNum
                    </button>
                }
            }

            <button class="lts-page-btn" disabled="@(CurrentPage == TotalPages)" @onclick="() => GoTo(CurrentPage + 1)" title="Next page">
                <i class="bi bi-chevron-right"></i>
            </button>
            <button class="lts-page-btn" disabled="@(CurrentPage == TotalPages)" @onclick="() => GoTo(TotalPages)" title="Last page">
                <i class="bi bi-chevron-bar-right"></i>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)Math.Max(1, PageSize)));
    private int StartItem => TotalItems == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndItem => Math.Min(TotalItems, CurrentPage * PageSize);

    private IEnumerable<int> VisiblePages
    {
        get
        {
            const int window = 1;
            var pages = new List<int>();
            for (var p = 1; p <= TotalPages; p++)
            {
                if (p == 1 || p == TotalPages || Math.Abs(p - CurrentPage) <= window)
                    pages.Add(p);
                else if (pages.Count == 0 || pages[^1] != -1)
                    pages.Add(-1);
            }
            return pages;
        }
    }

    private async Task GoTo(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;
        await PageChanged.InvokeAsync(page);
    }
}
