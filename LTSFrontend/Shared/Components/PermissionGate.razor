@* Shows child content only when the current user's role is in Roles (comma-separated). *@
@using LTSFrontend.State
@inject UserSessionState Session

@if (IsAllowed)
{
    @ChildContent
}

@code {
    [Parameter] public string Roles { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // TEMP-DISABLED-FOR-TESTING: always allow, ignoring Roles/Session, so every
    // action button is visible while pages are being checked. Restore the real
    // check below before going live:
    // private bool IsAllowed =>
    //     !string.IsNullOrWhiteSpace(Session.Role) &&
    //     Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
    //         .Contains(Session.Role, StringComparer.OrdinalIgnoreCase);
    private bool IsAllowed => true;
}
