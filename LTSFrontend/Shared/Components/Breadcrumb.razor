@namespace LTSFrontend.Shared.Components

<nav class="lts-breadcrumb" aria-label="Breadcrumb">
    <ol>
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var isLast = i == Items.Count - 1;
            <li class="@(isLast ? "active" : "")">
                @if (!isLast && !string.IsNullOrWhiteSpace(item.Href))
                {
                    <a href="@item.Href">@item.Text</a>
                }
                else
                {
                    <span aria-current="page">@item.Text</span>
                }
                @if (!isLast)
                {
                    <i class="bi bi-chevron-right lts-breadcrumb-sep"></i>
                }
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter] public List<BreadcrumbItem> Items { get; set; } = new();

    public class BreadcrumbItem
    {
        public string Text { get; set; } = string.Empty;
        public string? Href { get; set; }
    }
}
